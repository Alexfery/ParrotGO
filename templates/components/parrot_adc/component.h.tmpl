#pragma once

// Generated by Parrot; shared by all Parrot ADC components.
//
// ESP-IDF allows each ADC unit to be created only once, so the unit handles
// live here and every ADC component asks for its unit's handle.

#include "esp_adc/adc_oneshot.h"
#include "esp_err.h"

// Returns the oneshot handle of unit, creating the unit on first use.
// Call it from one task at a time (e.g. from the components' init functions).
esp_err_t parrot_adc_unit(adc_unit_t unit, adc_oneshot_unit_handle_t *handle);
